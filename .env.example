# Database
DATABASE_URL="postgresql://user:password@localhost:5432/buglyze?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Gemini API (for AI-powered analysis) - PRIMARY
GEMINI_API_KEY="your-gemini-api-key-here"

# OpenAI API (legacy - optional, can use Gemini instead)
OPENAI_API_KEY="sk-your-openai-api-key"

# Stripe (for billing)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# AWS S3 (for artifact storage)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="buglyze-artifacts"

# Redis (for queue and cache)
REDIS_URL="redis://localhost:6379"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Feature Flags
NEXT_PUBLIC_ENABLE_VISUAL_REGRESSION="true"
NEXT_PUBLIC_ENABLE_ACCESSIBILITY="true"
NEXT_PUBLIC_ENABLE_SEO="true"
NEXT_PUBLIC_ENABLE_SECURITY="true"
